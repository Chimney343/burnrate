# Garmin API Credentials
GARMIN_EMAIL=your.email@example.com
GARMIN_PASSWORD=your_secure_password

# Data Storage (leave empty to use default: project_root/data)
DATA_DIR=
TOKEN_STORE=~/.garminconnect

# Download Options
DOWNLOAD_ACTIVITIES=true
DOWNLOAD_HEALTH=true
DOWNLOAD_DEVICES=true
DOWNLOAD_GEAR=true

# API Configuration
ACTIVITY_LIMIT=100
DAYS_BACK=30

# Logging
LOG_LEVEL=INFO
# LOG_FILE=./logs/downloader.log
